#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "$0")" && pwd)"
if [[ ${1:-} == --root && $# == 2 ]]; then
    root=$2
elif [[ $# == 0 ]]; then
    container=$(mktemp -d "${STORY584_SCRATCH:?external scratch required}/paths-XXXXXX")
    trap 'rm -rf "$container"' EXIT
    root="$container/source"
    "$script_dir/source-tree" "$root"
else
    exit 2
fi
python3 - "$root" <<'PY'
import os
from pathlib import Path
import sys

needle = b'/' + b'Users/'
root = Path(sys.argv[1])
failed = False

def reject(reason, relative):
    global failed
    print('no-developer-paths: ' + reason + ' in ' + repr(str(relative)), file=sys.stderr)
    failed = True

try:
    if not root.is_dir():
        raise ValueError('missing source root')
    def onerror(error):
        raise error
    for directory, dirs, files in os.walk(root, followlinks=False, onerror=onerror):
        for name in dirs + files:
            path = Path(directory) / name
            relative = path.relative_to(root)
            relative_path_bytes = b'/' + os.fsencode(relative)
            if needle in relative_path_bytes:
                reject('developer filename', relative)
            if path.is_symlink():
                symlink_target_bytes = os.fsencode(os.readlink(path))
                if needle in symlink_target_bytes:
                    reject('developer symlink', relative)
            elif path.is_file():
                exempt = str(relative).startswith('scripts/ci/fixtures/no-developer-paths/')
                content = path.read_bytes()
                if not exempt and needle in content:
                    reject('developer content', relative)
    if failed:
        sys.exit(1)
    print('no-developer-paths: clean')
except (OSError, ValueError) as error:
    print('no-developer-paths: ' + str(error), file=sys.stderr)
    sys.exit(1)
PY
