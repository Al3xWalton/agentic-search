#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "$0")" && pwd)"
scanner="${STORY584_TOOLS:?external tools required}/bin/gitleaks"
if [[ ${1:-} == --root && ${3:-} == --scanner && $# == 4 ]]; then
    root=$2
    scanner=$4
elif [[ $# == 0 ]]; then
    container=$(mktemp -d "${STORY584_SCRATCH:?external scratch required}/secrets-XXXXXX")
    trap 'rm -rf "$container"' EXIT
    root="$container/source"
    "$script_dir/source-tree" "$root"
else
    exit 2
fi
mkdir -p "${VERIFICATION:-${STORY584_ARTIFACT_DIR:?external artifacts required}}"
report_dir=${VERIFICATION:-$STORY584_ARTIFACT_DIR}
# Evidence uses default rules; only the whole source scan applies the reviewed fixture paths.
unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML
scanner=$(python3 - "$scanner" <<'PY'
from pathlib import Path
import sys
print(Path(sys.argv[1]).resolve())
PY
)
scan() {
    local source=$1 report=$2 status=0
    shift 2
    (cd "${STORY584_SCRATCH:?external scratch required}" && "$scanner" dir "$source" --redact --no-banner --ignore-gitleaks-allow --report-format json --report-path "$report" "$@") || status=$?
    return "$status"
}
status=0
if [[ -d "$root/.spike" ]]; then
    scan "$root/.spike" "$report_dir/gitleaks-spike.json" || status=$?
else
    echo 'secrets: evidence subtree absent before evidence import'
fi
scan "$root" "$report_dir/gitleaks-tree.json" --config "$root/.gitleaks.toml" || status=$?
[[ $status == 0 ]] || exit "$status"
"$script_dir/no-developer-paths" --root "$root"
