#!/usr/bin/env bash
set -euo pipefail

verify_archive() {
    python3 - "$1" "$2" <<'PY'
import hashlib
from pathlib import Path
import sys
try:
    actual = hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest()
    if actual != sys.argv[2]:
        raise ValueError('archive checksum mismatch')
    print('install-tools: archive checksum verified')
except (OSError, ValueError) as error:
    print('install-tools: ' + str(error), file=sys.stderr)
    sys.exit(1)
PY
}

if [[ ${1:-} == --verify-archive && $# == 3 ]]; then
    verify_archive "$2" "$3"
    exit 0
fi
[[ $# == 1 ]] || { echo 'usage: install-tools EXTERNAL_DIRECTORY' >&2; exit 2; }
destination=$1
python3 - "$destination" "$(cd "$(dirname "$0")/../.." && pwd)" <<'PY'
from pathlib import Path
import sys
path, root = map(lambda s: Path(s).resolve(), sys.argv[1:])
if path == root or root in path.parents:
    sys.exit('install-tools: tool directory must be external')
PY
mkdir -p "$destination/bin"
export CARGO_TARGET_DIR
CARGO_TARGET_DIR=$(mktemp -d "${STORY584_SCRATCH:?external scratch required}/target-tools-XXXXXX")
cargo install --locked --version 0.15.0 wasm-pack --root "$destination"
# cargo-about exposes its executable only with the cli feature.
cargo install --locked --version 0.9.2 cargo-about --features cli --root "$destination"
cargo install --locked --version 0.5.9 cargo-cyclonedx --root "$destination"
# Published digests: https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_checksums.txt
case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) asset=gitleaks_8.30.1_darwin_arm64.tar.gz; digest=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5 ;;
    Linux-x86_64) asset=gitleaks_8.30.1_linux_x64.tar.gz; digest=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;;
    *) echo 'install-tools: unsupported platform' >&2; exit 1 ;;
esac
curl --fail --location --proto '=https' --tlsv1.2 \
    "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/$asset" -o "$destination/$asset"
verify_archive "$destination/$asset" "$digest"
tar -xzf "$destination/$asset" -C "$destination/bin" gitleaks
export PATH="$destination/bin:$PATH"
wasm-pack --version
cargo about --version
cargo cyclonedx --version
gitleaks version
