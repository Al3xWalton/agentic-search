#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "$0")" && pwd)"
container=$(mktemp -d "${STORY584_SCRATCH:?external scratch required}/sbom-XXXXXX")
trap 'rm -rf "$container"' EXIT
source="$container/source"
"$script_dir/source-tree" "$source"
mkdir -p "${STORY584_ARTIFACT_DIR:?external artifacts required}/members"
cd "$source"
cargo metadata --locked --format-version 1 > "$container/metadata.json"
cp Cargo.lock "$container/Cargo.lock"
python3 - Cargo.lock <<'PY'
import hashlib
from pathlib import Path
import sys
print('Cargo.lock SHA256 ' + hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest())
PY
# The pinned tool defaults to crate-name.cdx.json; request the contract filename explicitly.
CARGO_NET_OFFLINE=true cargo cyclonedx --format json --spec-version 1.5 --all --target all --override-filename bom
cmp Cargo.lock "$container/Cargo.lock"
python3 - "$container/metadata.json" "$STORY584_ARTIFACT_DIR" <<'PY'
import json
from pathlib import Path
import shutil
import sys
metadata = json.loads(Path(sys.argv[1]).read_bytes())
root = Path(metadata['workspace_root'])
artifacts = Path(sys.argv[2])
members = set(metadata['workspace_members'])
for package in metadata['packages']:
    if package['id'] in members:
        manifest = Path(package['manifest_path'])
        bom = manifest.parent / 'bom.json'
        if not bom.is_file():
            sys.exit('sbom: missing member BOM ' + str(manifest.relative_to(root)))
        destination = artifacts / 'members' / bom.relative_to(root)
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(bom, destination)
        print('sbom: collected ' + str(bom.relative_to(root)))
shutil.copyfile(root / 'crates/core/bom.json', artifacts / 'sbom.json')
PY
"$script_dir/check-sbom" "$STORY584_ARTIFACT_DIR/sbom.json"
