# Keep bulky local artifacts/caches and the original brief out of evidence commits.
/cargo/
/target-*/
/tmp/
/.firecrawl/
/SPIKE-BRIEF.md
/data/*-indexed.jsonl
/data/cc-parsed.jsonl
/data/*.warc.gz
